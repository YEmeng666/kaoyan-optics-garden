---
import Layout from '../layouts/Layout.astro';
import TopicProgress from '../components/TopicProgress.astro';
import {studyCards,studyTopics} from '../lib/study-data.mjs';
import {course,href} from '../lib/data.mjs';
---
<Layout title="背诵与练题 · 我的学习进度" active="study" studyCatalog>
 <section class="page-heading"><p class="eyebrow">主动回忆 / 公式与解题</p><h1>先想一遍，再看答案。</h1><p>32 张公式卡 · 29 道例题 · 29 道课后自测。先默写公式与适用条件，或独立写出解题过程，再对照解析自评。练习题为本站原创辅助题，<a href={href('questions/')}>历年真题仍是主要题源 →</a></p></section>
 <section class="study-summary" aria-label="学习概况"><div><span>知识点平均掌握</span><strong id="study-average">—</strong></div><div><span>到期复习</span><strong id="study-due">—</strong></div><div><span>尚未练习</span><strong id="study-new">—</strong></div><div><span>薄弱卡片</span><strong id="study-weak">—</strong></div></section>
 <section class="finder study-settings" aria-labelledby="study-settings-title"><h2 id="study-settings-title">安排这一轮</h2>
  <form id="study-form" data-cards-url={href('data/study-cards.json')}><div class="study-filter-grid">
   <label>章节<select name="chapter"><option value="">全部章节</option>{course.chapters.map(ch=><option value={ch.id}>第 {ch.id} 章 · {ch.title}</option>)}</select></label>
   <label>知识点<select name="topic"><option value="">全部知识点</option>{studyTopics.map(t=><option value={t.id} data-chapter={t.chapter}>{t.title}</option>)}</select></label>
   <label>练习内容<select name="kind"><option value="all">公式 + 例题 + 课后题</option><option value="formula">公式背诵</option><option value="question">例题与课后题</option></select></label>
   <label>范围<select name="scope"><option value="due">到期优先 + 新卡</option><option value="weak">薄弱卡片（自评未掌握 / 需提示）</option><option value="all">全部卡片</option></select></label>
   <label>本轮数量<select name="limit"><option value="10">10 张</option><option value="20" selected>20 张</option><option value="50">50 张</option><option value="100">全部（最多 100 张）</option></select></label>
  </div><p><button type="submit" class="button" id="study-start">开始这一轮 →</button> <span id="study-eligible" class="source"></span></p></form>
  <p class="source">看完解析后按真实表现自评：未掌握 10 分钟后再练，需提示 1 天后复习，基本掌握从 1 天起递增，熟练掌握从 3 天起递增。自评与间隔安排仅用于辅助复习。</p>
 </section>
 <p id="study-message" class="notice" role="status" aria-live="polite">学习记录保存在当前浏览器。不同设备、域名和镜像站之间需通过导出 / 导入迁移。</p>
 <section id="study-session" class="study-session" hidden aria-labelledby="study-card-title">
  <div class="progress-heading"><span id="study-session-position"></span><button class="button secondary" id="study-stop" type="button">结束本轮</button></div><progress id="study-session-progress" max="100" value="0" aria-label="本轮完成进度"></progress>
  <div class="study-card"><p id="study-card-kind" class="eyebrow"></p><h2 id="study-card-title" tabindex="-1"></h2><p id="study-card-prompt" class="study-prompt"></p>
   <label for="study-notes">先写下公式、条件或解题步骤（本轮草稿，不保存）</label><textarea id="study-notes" rows="5" placeholder="先识别模型：已知什么？求什么？第一步为什么这样做？"></textarea>
   <details id="study-hint" hidden><summary>需要一点提示</summary><p id="study-card-cue"></p></details>
   <p><button id="study-reveal" type="button" class="button">写好了，查看答案与思路</button></p>
   <div id="study-answer" hidden><div id="study-answer-content"></div><p class="source" id="study-card-source"></p>
    <fieldset class="study-ratings"><legend>对照后如实自评（系统不会自动判断你的草稿）</legend><div class="study-rating-grid"><button type="button" data-rating="0">未掌握<small>不会 / 做错了</small></button><button type="button" data-rating="1">需提示<small>依赖提示或解析</small></button><button type="button" data-rating="2">基本掌握<small>独立完成，仍有遗漏</small></button><button type="button" data-rating="3">熟练掌握<small>独立完成并解释条件</small></button></div></fieldset>
   </div><p><a id="study-topic-link" class="inline-link" href={href('knowledge/')}>返回知识点复习 →</a></p>
  </div>
 </section>
 <section class="finder" id="study-finished" hidden aria-labelledby="study-finished-title"><h2 id="study-finished-title">这一轮已结束</h2><p id="study-finished-summary" role="status"></p><button id="study-retry" class="button secondary" type="button">再练薄弱卡片</button></section>
 <section aria-labelledby="study-topics-title"><div class="section-head"><h2 id="study-topics-title">每个知识点的掌握进度</h2><a href={href('knowledge/')}>打开知识地图 →</a></div><p class="source">进度由理解自评、公式卡和解题卡共同计算；仅打开页面或查看答案不会增加进度。理解程度请在对应知识页设置。</p>
  <div class="knowledge-grid">{studyTopics.map(t=><article class="knowledge-card" data-dashboard-topic={t.id}><p class="eyebrow">第 {t.chapter} 章</p><h3><a href={href(`knowledge/${t.id}/`)}>{t.title} ↗</a></h3><TopicProgress id={t.id}/><a class="inline-link" href={href(`study/?topic=${t.id}`)}>背诵与练题 →</a></article>)}</div>
 </section>
 <section class="finder study-backup" aria-labelledby="study-backup-title"><h2 id="study-backup-title">备份学习记录</h2><p>清理浏览器数据会丢失本机记录，建议定期导出。导入会合并记录，同一条目保留更新时间较新的自评。</p><button id="study-export" type="button" class="button secondary">导出记录 JSON</button><label for="study-import">导入记录 <input id="study-import" type="file" accept=".json,application/json" /></label></section>
 <noscript><p class="warning">进度和背诵练习需要 JavaScript。仍可打开知识页阅读公式、例题与解析。</p></noscript>
 <script id="study-client-config" type="application/json" set:html={JSON.stringify({knowledgeBase:href('knowledge/')}).replaceAll('<','\\u003c')}/>
 <script>import '../scripts/study-client.mjs';</script>
</Layout>
